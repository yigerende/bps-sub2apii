# =============================================================================
# bps-sub2api Deploy Directory - Git Ignore
# =============================================================================

# Data directories (generated at runtime when using docker-compose.local.yml)
data/
postgres_data/
redis_data/

# Environment configuration (contains sensitive information)
.env

# Backup files
*.backup
*.bak

# Temporary files
*.tmp
*.log

# Isolated bps-sub2api bind mounts
bps-sub2api-data/
bps-sub2api-postgres-data/
bps-sub2api-redis-data/
