[Unit]
Description=bps-sub2api Copilot SDK Responses sidecar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bps-sub2api-copilot
Group=bps-sub2api-copilot
WorkingDirectory=/opt/bps-sub2api-copilot/adapter
EnvironmentFile=/etc/bps-sub2api/copilot-sidecar.env
ExecStart=/opt/bps-sub2api-copilot/adapter/.venv/bin/python /opt/bps-sub2api-public/deploy/copilot-sdk/server.py
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=bps-sub2api-copilot
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bps-sub2api-copilot
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
